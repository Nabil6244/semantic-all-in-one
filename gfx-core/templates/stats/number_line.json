   "default": "",
   "from": "label"
  },
  "rows": {
   "default": [
    {
     "label": "A",
     "value": 1
    },
    {
     "label": "B",
     "value": 10
    }
   ],
   "from": "rows",
   "required": true
  },
  "log": {
   "default": false
  }
 },
 "items": [
  {
   "p": "numberline",
   "rows": "{rows}",
   "title": "{title}",
   "log": "{log}",
   "in": 0.2
  }
 ]
}