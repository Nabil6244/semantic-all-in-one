   "required": true
  },
  "values": {
   "default": [
    181,
    178,
    99,
    26,
    29,
    19,
    8,
    2,
    1,
    1,
    9,
    56
   ],
   "from": "values",
   "required": true
  },
  "labels": {
   "default": [
    "J",
    "F",
    "M",
    "A",
    "M",
    "J",
    "J",
    "A",
    "S",
    "O",
    "N",
    "D"
   ],
   "from": "labels",
   "required": true
  },
  "footnote": {
   "default": "MM \u00b7 LONG-TERM AVERAGE (APPROX.)",
   "from": "text"
  },
  "highlight": {
   "default": -1
  }
 },
 "items": [
  {
   "p": "tag",
   "text": "{tag}",
   "at": [
    0.008,
    0.012
   ],
   "bg": "ink",
   "color": "red",
   "size": 26,
   "in": 0.1
  },
  {
   "p": "columns",
   "title": "{title}",
   "values": "{values}",
   "labels": "{labels}",
   "footnote": "{footnote}",
   "highlight": "{highlight}",
   "at": [
