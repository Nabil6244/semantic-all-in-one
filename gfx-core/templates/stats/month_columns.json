{
 "id": "month_columns",
 "family": "stats",
 "use": "A dark card with a 12-month (or any) column chart over a map or footage: values above the bars, letters below.",
 "niches": [
  "map",
  "travel",
  "geopolitics"
 ],
 "plate": false,
 "hold": 8,
 "tags": [
  "chart",
  "monthly",
  "climate",
  "data"
 ],
 "slots": {
