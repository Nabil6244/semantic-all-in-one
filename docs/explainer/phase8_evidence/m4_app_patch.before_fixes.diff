+    def _on_hybrid_explainer_changed(self) -> None:
+        """Opt-in Explainer look (off by default): it only enables 'Direct with Explainer'. Nothing about the current plan or the render changes until that button is used."""
+        on = bool(self._hybrid_explainer_var.get())
+        self._settings["explainer_style"] = on
+        try:
+            self._persist_global_settings()
+        except Exception:
+            pass
+        self._hybrid_explainer_btn.configure(state="normal" if on else "disabled")
+
+    def _hybrid_explainer_direct(self) -> None:
+        """Voiceover + script -> the Explainer director -> a Hybrid plan, installed through the same path as 'Write plan with AI'. Any failure keeps the current plan."""
+        if self._hybrid_running or self._hybrid_busy or not self._hybrid_explainer_var.get():
+            return
+        if not self._require_workspace("direct a Hybrid plan with the Explainer look"):
+            return
+        voiceover_path = self._current_voiceover_path()
+        if voiceover_path is None:
+            messagebox.showinfo("Direct with Explainer", "Select or import a voiceover first: the plan is made from the narration's real timing.")
+            return
+        script = self._vo_script_text()
+        whisper_model = self.model_var.get().strip() or "base"
+        whisper_state_dir = getattr(self._workspace, "state_dir", None)
+        work_dir = str(self._workspace.hybrid_dir)
+        self._hybrid_busy = True
+        self._hybrid_explainer_btn.configure(state="disabled", text="Directing…")
+        self._append_log("[HYBRID] Directing with the Explainer look…\n")
+        work = self._hybrid_progress_start("Directing the Explainer look", "Listening to the narration first (the first time can take a few minutes).")
 
+        def post(fn) -> None:
+            self.after(0, fn)
+
+        def worker() -> None:
+            try:
+                from explainer.integration import direct_plan
+                from pakmap.app_integration import voiceover_duration
+
+                words = self._pakmap_get_words(voiceover_path, whisper_model, whisper_state_dir, lambda m: post(lambda: self._append_log(m + "\n")))
+                out = direct_plan(words, script or None, self._settings, work_dir=work_dir, duration=voiceover_duration(voiceover_path),
+                                  log=lambda m: post(lambda: self._append_log(f"[HYBRID] {m}\n")))
+                post(lambda: finish(out, None))
+            except BaseException as exc:  # incl. SystemExit: the panel must never be left busy
+                post(lambda e=exc: finish(None, e))
+
+        def finish(out, exc) -> None:
+            if work != self._hybrid_work_id:
+                return   # stopped by the user: a late answer is ignored
+            self._hybrid_busy = False
+            self._hybrid_explainer_btn.configure(state="normal" if self._hybrid_explainer_var.get() else "disabled", text="Direct with Explainer")
+            if exc is not None or out.get("plan") is None:
+                why = str(exc) if exc is not None else "; ".join(out.get("problems") or ["no plan"])
+                self._append_log(f"[HYBRID] The Explainer director could not make a plan: {why}. Your current plan is unchanged.\n")
+                self._hybrid_progress_done(work, "The Explainer plan could not be made; your current plan is unchanged.")
+                messagebox.showerror("Direct with Explainer", f"The plan could not be made. Your current plan is unchanged.\n\n{why[:600]}")
+                return
+            from hybrid.plan import HybridPlan
+
+            plan = HybridPlan.from_dict(out["plan"])
+            self._hybrid_progress_done(work)
+            self._hybrid_set_plan(plan, None)
+            for w in out.get("warnings") or []:
+                self._append_log(f"[HYBRID] {w}\n")
+            self._hybrid_status_var.set(f"Explainer plan ready: {len(plan.beats)} beats. Check the plan, then get the scenes and render as usual.")
+            self._append_log(f"[HYBRID] Explainer plan ready ({len(plan.beats)} beats).\n")
+
+        threading.Thread(target=worker, daemon=True).start()
+
