 "duration_s": 47.048,
 "sentences": 13,
 "sentence_labels": [
  {
   "i": 0,
   "label": "hook",
   "trigger": "",
   "start": 0.0,
   "end": 1.68,
   "text": "Look at Korea from space at night.",
   "words": 7
  },
  {
   "i": 1,
   "label": "explain",
   "trigger": "",
   "start": 1.94,
   "end": 5.1,
   "text": "The South is blazing with light cities glowing like spilled gold.",
   "words": 11
  },
  {
   "i": 2,
   "label": "explain",
   "trigger": "",
   "start": 5.32,
   "end": 7.24,
   "text": "And then right above it, there's nothing.",
   "words": 7
  },
  {
   "i": 3,
   "label": "explain",
   "trigger": "",
   "start": 7.56,
   "end": 11.86,
   "text": "A black hole the size of England where a country of 26 million people should be.",
   "words": 16
  },
  {
   "i": 4,
   "label": "explain",
   "trigger": "",
   "start": 12.14,
   "end": 14.7,
   "text": "From up there, South Korea looks like an island.",
   "words": 9
  },
  {
   "i": 5,
   "label": "explain",
   "trigger": "",
   "start": 14.7,
   "end": 16.76,
   "text": "That dark country is North Korea.",
   "words": 6
  },
  {
   "i": 6,
   "label": "explain",
   "trigger": "",
   "start": 17.1,
   "end": 21.2,
   "text": "Its founder died in 1994 and officially he's still its eternal leader.",
   "words": 12
  },
  {
   "i": 7,
   "label": "explain",
   "trigger": "",
   "start": 21.48,
   "end": 25.62,
   "text": "Since then, his son and his grandson have run the place like a family business.",
   "words": 15
  },
  {
   "i": 8,
   "label": "explain",
   "trigger": "",
   "start": 25.62,
   "end": 31.82,
   "text": "it's a country where your radio is fixed to the government station where watching a south korean tv show can",
   "words": 20
  },
  {
   "i": 9,
   "label": "explain",
   "trigger": "",
   "start": 31.82,
   "end": 37.56,
   "text": "get you sent to a prison camp and where kids are taught that their leader family has almost magical powers",
   "words": 20
  },
  {
   "i": 10,
   "label": "explain",
   "trigger": "",
   "start": 37.96,
   "end": 39.76,
   "text": "And here's what makes it truly strange.",
   "words": 7
  },
  {
   "i": 11,
   "label": "explain",
   "trigger": "",
   "start": 39.76,
   "end": 42.74,
   "text": "80 years ago, North and South were the same country.",
   "words": 10
  },
  {
   "i": 12,
   "label": "explain",
   "trigger": "",
   "start": 43.06,
   "end": 46.06,
   "text": "Same language, same food, same families.",
   "words": 6
  }
 ],
