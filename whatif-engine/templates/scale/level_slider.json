{
 "id": "level_slider",
 "family": "scale",
 "use": "A level between two ends as a bar that fills, with named points on it: gravity from 0 G (weightless) to 1 G with the Moon at 1/6 (V5 9:30). text = NAME=fraction 0..1.",
 "tags": [
  "scale",
  "gravity",
  "level"
 ],
 "plate": true,
 "hold": 7,
 "cite": "ILLUSTRATION",
 "tint": "cool",
