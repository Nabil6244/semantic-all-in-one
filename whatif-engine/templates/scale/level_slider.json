  },
  "sub": {
   "default": "",
   "from": "sub"
  },
  "left": {
   "default": "0 G"
  },
  "right": {
   "default": "1 G"
  },
  "level": {
   "default": 0.0,
   "from": "value_to"
  },
  "color": {
   "default": "cyan"
  },
  "marks": {
   "default": [],
   "from": "text",
   "kind": "pairs"
  }
 },
