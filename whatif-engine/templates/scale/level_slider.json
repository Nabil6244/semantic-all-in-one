  {
   "p": "particles",
   "mode": "stars",
   "count": 160,
   "alpha": 0.5,
   "in": 0,
   "appear": "cut",
   "seed": 5
  },
  {
   "p": "bar",
   "at": [
    0.12,
    0.6
   ],
   "w": 0.76,
   "h": 14,
   "color": "{color}",
   "in": 0.2,
   "anim": {
    "value": [
     [
      0.4,
      0
     ],
     [
      2.4,
      "{level}"
     ]
    ]
   }
  },
  {
   "p": "text",
   "text": "{left}",
   "at": [
    0.12,
    0.66
   ],
   "size": 15,
   "font": "mono",
   "in": 0.3
  },
  {
   "p": "text",
   "text": "{right}",
   "at": [
    0.88,
    0.66
   ],
   "size": 15,
   "font": "mono",
   "align": "right",
   "in": 0.3
  },
  {
   "p": "dot",
   "each": "marks",
   "at": [
