{
 "id": "day_night_strip",
 "family": "time",
 "use": "Days rushing past: the sun swings over a horizon faster and faster, the day counter climbing.",
 "tags": [
  "time",
  "day"
 ],
 "plate": true,
 "hold": 6,
 "cite": "ILLUSTRATION",
 "tint": "dark",
 "slots": {
  "days": {
   "default": 12,
   "from": "value_to"
  },
  "format": {
   "default": "DAYS",
   "from": "format"
  }
 },
 "items": [
  {
   "p": "band",
   "box": [
    0,
    0.7,
    1,
    1
   ],
   "colors": [
    "#0B0E14",
    "#05070B"
   ],
   "dir": "v",
   "opacity": 1,
   "in": 0
  },
  {
   "p": "line",
   "from": [
    0,
    0.7
   ],
   "to": [
    1,
    0.7
   ],
   "color": "rgba(255,255,255,0.3)",
   "width": 1.2,
   "in": 0
  },
  {
   "p": "dot",
   "orbit": {
    "c": [
     0.5,
     0.7
    ],
    "rx": 0.6,
    "ry": 0.5,
    "deg0": 180,
    "turns": "{days}"
   },
   "anim": {
    "along": {
     "keys": [
      [
       0.3,
       0
      ],
      [
