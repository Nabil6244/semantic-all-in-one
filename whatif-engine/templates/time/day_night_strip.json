       1
      ]
     ],
     "ease": "in"
    }
   },
   "r": 12,
   "color": "amber",
   "ring": false,
   "in": 0.2
  },
  {
   "p": "number",
   "at": [
    0.035,
    0.9
   ],
   "anim": {
    "value": {
     "keys": [
      [
       0.3,
       0
      ],
      [
       "end",
       "{days}"
      ]
     ],
     "ease": "in"
    }
   },
   "unit": "{format}",
   "size": 40,
   "in": 0.3
  }
 ],
 "triggers": "\\b(a day lasts|days? (go|pass|fly))\\b"
}
