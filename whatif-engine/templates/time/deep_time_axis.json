{
 "id": "deep_time_axis",
 "family": "time",
 "use": "Deep time on one logarithmic line of years (10^10 ... 10^67), with events as dots and a line of comparison under it (V4 8:40 'BLACK HOLES DON'T LAST FOREVER').",
 "tags": [
  "time",
  "scale",
  "deep time",
  "log"
 ],
 "plate": true,
 "hold": 9,
 "cite": "ILLUSTRATION · YEARS ON A POWERS-OF-TEN SCALE",
 "tint": "cool",
 "slots": {
  "label": {
   "default": "BLACK HOLES DON'T LAST FOREVER",
   "from": "label"
  },
  "events": {
   "default": [
    {
     "name": "THE UNIVERSE SO FAR",
     "value": "~14 BILLION YEARS",
     "num": 10.1
    },
    {
     "name": "SGR A* EVAPORATES",
     "value": "~10^67 YEARS",
     "num": 67
    }
   ],
   "from": "text",
   "kind": "pairs"
  },
  "min_exp": {
   "default": 10
  },
  "max_exp": {
   "default": 67
  },
  "every": {
   "default": 6
  },
  "note": {
   "default": "",
   "from": "sub"
  }
 },
 "items": [
  {
   "p": "particles",
   "mode": "stars",
   "count": 160,
   "alpha": 0.5,
   "in": 0,
   "appear": "cut",
   "seed": 5
  },
  {
   "p": "axis",
   "from": [
    0.1,
    0.56
   ],
   "to": [
    0.88,
    0.56
   ],
   "color": "rgba(200,210,220,0.6)",
   "log": {
    "from": "{min_exp}",
    "to": "{max_exp}",
    "every": "{every}"
   },
   "tick_size": 12,
   "m": "draw",
   "dur": 1.6,
   "in": 0.3
  },
  {
   "p": "dot",
   "each": "events",
   "at": [
    "=0.1+0.78*({it.num}-{min_exp})/({max_exp}-{min_exp})",
    0.56
   ],
   "r": 6,
   "color": "white",
   "in": 1.6,
   "stagger": 1.4,
   "label": "{it.name}",
   "label_side": "top",
   "label_size": 14,
   "label_color": "cyan",
   "sub": "{it.value}",
   "label_gap": 26
  },
  {
   "p": "text",
   "text": "{note}",
   "at": [
    0.5,
    0.78
   ],
   "size": 14,
   "font": "mono",
   "align": "center",
   "color": "gold",
   "in": "75%"
  },
  {
   "p": "text",
   "text": "{label}",
   "at": [
    0.035,
    0.11
   ],
   "size": 34,
   "font": "display",
   "glow": true,
   "in": 0.05
  }
 ],
 "triggers": "\\b(trillions?|10 to the|billions of billions|forever)\\b.*\\byears\\b",
 "source": "V4 8:40"
}
