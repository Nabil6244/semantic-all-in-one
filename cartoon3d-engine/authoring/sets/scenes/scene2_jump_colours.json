  {"who": "host", "text": "Two!", "voice": "en-US-AvaNeural", "pitch": "+6Hz", "act": "count", "also": {"noraiz": "jump"}, "card": "2", "sfx": "ding_2", "gap_after": 0.5},
  {"who": "host", "text": "Three!", "voice": "en-US-AvaNeural", "pitch": "+6Hz", "act": "count", "also": {"noraiz": "jump"}, "card": "3", "sfx": "ding_3", "gap_after": 0.5},
  {"who": "host", "text": "Four!", "voice": "en-US-AvaNeural", "pitch": "+6Hz", "act": "count", "also": {"noraiz": "jump"}, "card": "4", "sfx": "ding_4", "gap_after": 0.5},
  {"who": "host", "text": "Five!", "voice": "en-US-AvaNeural", "pitch": "+6Hz", "act": "count", "also": {"noraiz": "jump"}, "card": "5", "sfx": "ding_5", "gap_after": 0.5},
  {"who": "hoorain", "text": "Five jumps! Yay, Noraiz!", "voice": "en-US-AnaNeural", "act": "clap", "sfx": "success"},
  {"who": "host", "text": "Now, a colour game! What colour is Hoorain's shirt? Can you say it?", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "point", "gap_after": 1.4},
  {"who": "hoorain", "text": "Pink! My shirt is pink!", "voice": "en-US-AnaNeural", "act": "cheer", "cam": "kids", "card": "PINK", "sfx": "chime"},
  {"who": "host", "text": "Yes, pink! And my overalls are blue. Say it with me. Blue!", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "open", "card": "BLUE", "card_at": 0.55},
  {"who": "noraiz", "text": "Blue! Hee hee, I said it first!", "voice": "en-US-AnaNeural", "rate": "+8%", "pitch": "-14Hz", "act": "giggle", "cam": "kids", "gap_after": 0.2},
  {"who": "hoorain", "text": "No, I did!", "voice": "en-US-AnaNeural", "act": "talk"},
  {"who": "host", "text": "You both did! Great job! Let's give a big clap!", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "clap", "also": {"hoorain": "clap", "noraiz": "clap"}, "cam": "group", "sfx": "success"},
  {"who": "host", "text": "Now everybody, jump with us! Jump, jump, jump!", "voice": "en-US-AvaNeural", "rate": "-2%", "pitch": "+6Hz", "act": "jump", "also": {"hoorain": "jump", "noraiz": "jump"}, "sfx": "pop"},
  {"who": "host", "text": "Thank you for playing, friends! Bye bye!", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "wave"},
  {"who": "hoorain", "text": "Bye bye!", "voice": "en-US-AnaNeural", "act": "wave", "also": {"noraiz": "wave"}, "cam": "kids", "gap_after": 0.2},
