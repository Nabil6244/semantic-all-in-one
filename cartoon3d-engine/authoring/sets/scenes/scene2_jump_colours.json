 "lines": [
  {"who": "host", "text": "Hi friends! Welcome back to Rainbow Playland!", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "wave", "cam": "group"},
  {"who": "hoorain", "text": "Hi! I'm Hoorain!", "voice": "en-US-AnaNeural", "act": "wave", "gap_after": 0.25},
  {"who": "noraiz", "text": "And I'm Noraiz!", "voice": "en-US-AnaNeural", "rate": "+8%", "pitch": "-14Hz", "act": "cheer"},
  {"who": "host", "text": "Today we will jump, count, and find colours! Are you ready?", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "open", "gap_after": 1.0},
  {"who": "hoorain", "text": "Ready!", "voice": "en-US-AnaNeural", "act": "cheer", "also": {"noraiz": "cheer"}, "cam": "kids", "sfx": "sparkle"},
  {"who": "host", "text": "Noraiz, can you jump five times? Let's count together!", "voice": "en-US-AvaNeural", "rate": "-4%", "pitch": "+6Hz", "act": "point"},
  {"who": "noraiz", "text": "Okay! Watch me!", "voice": "en-US-AnaNeural", "rate": "+8%", "pitch": "-14Hz", "act": "cheer"},
