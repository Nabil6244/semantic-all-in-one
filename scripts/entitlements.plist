<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarized build (Release Readiness
  Audit, Phase 1.3). Only the three exceptions PyInstaller onedir bundles
  actually need under the hardened runtime:
    - the many bundled third-party dylibs (onnxruntime, ctranslate2, numpy,
      PIL, av, ...) are not signed by this app's Team ID, so library
      validation must be relaxed or codesign/notarization would reject them;
    - CPython's own executable-memory use needs the unsigned-executable-
      memory exception under the hardened runtime.
  Does not grant camera/mic/network/file-access entitlements — none of those
  are restricted by the hardened runtime and the app does not need any
  additional capability beyond what it already has unsigned.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
