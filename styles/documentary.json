    "variety": {
      "high_visual_variety": true,
      "min_unique_keys": 0.7,
      "avoid_identical_compositions": true
    }
  },
  "pacing": {
    "default": "normal",
    "hook": "fast",
    "exposition": "normal",
    "evidence": "normal",
    "climax": "fast",
    "reflection": "slow",
    "transition_density": 0.38
  },
  "transitions": {
    "default": "dissolve",
    "preferred": ["dissolve", "soft", "fade", "cut"],
    "avoid": ["flash"]
  },
  "audio": {
    "ambience_intensity": 0.5,
    "sfx_intensity": 0.36,
    "music_intensity": 0.72,
    "music_duck_db": -12
  },
  "hook": {
    "window_seconds": 30,
    "attention_target": 0.78,
    "prefer_visual_change": true
  },
  "assets": {
    "preferred": ["stock_video", "youtube_video", "image", "video"],
    "avoid_repetition": true
  },
  "captions": {
    "style": "premium_documentary",
    "density": "medium",
    "emphasis": "selective"
  },
  "ai_visual_prompt": {
    "style": "cinematic documentary photography, rich lighting, environmental establishing shots, detail shots, controlled depth",
    "realism": 0.84,
    "composition": "intentionally composed; rule-of-thirds; layered depth; visual contrast; dramatic reveals",
    "avoid": [
      "stock-cliché handshakes",
      "flat office lighting",
      "busy text overlays in frame",
      "slideshow feel"
