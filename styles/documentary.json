  },
  "intelligence": {
    "weights": {
      "cinematic_potential": 0.32,
      "emotional_intensity": 0.22,
      "educational_density": 0.12,
      "evidence_density": 0.1,
      "visualization_need": 0.08,
      "scientific_density": 0.08,
      "historical_density": 0.08
    },
    "preview_visual": "Cinematic • Environment • Detail",
    "preview_camera": "Push-in • Drift • Hold",
    "preview_pacing": "Measured → Emotional peaks",
    "preview_audio": "Sophisticated • Cinematic",
    "variety_family": "cinematic",
    "influences": [
      "intentional_composition",
      "dynamic_emotional_pacing",
      "stronger_music_duck",
      "controlled_camera_motion"
    ]
