    "tone": "sophisticated, cinematic, deliberate",
    "best_for": ["premium docs", "nature", "investigative", "longform factual", "climate"]
  },
  "visual": {
    "treatment": "cinematic documentary",
    "camera": {
      "preferred": ["push_in", "subtle_drift", "hold", "pull_out"],
