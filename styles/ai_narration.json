{
  "id": "ai_narration",
  "version": 3,
  "name": "AI Narration",
  "identity": {
    "description": "Faceless narrated YouTube — visuals actively explain the narration with purposeful turnover.",
    "tone": "urgent, illustrative, explainer",
    "best_for": [
      "faceless youtube",
      "explainers",
      "listicles",
      "motivational narration"
    ]
  },
  "visual": {
    "treatment": "illustrative narration",
    "camera": {
      "preferred": [
        "push_in",
        "pull_out",
        "subtle_drift",
        "static"
      ],
      "intensity": 0.78
    },
    "motion_rules": {
      "max_static_streak": 2,
      "prefer_turnover": true,
      "narrative_beat_to_visual_beat": true
    },
    "variety": {
      "high_visual_variety": true,
      "min_unique_keys": 0.8,
      "avoid_generic_stock_repeats": true
    }
  },
  "pacing": {
    "default": "fast",
    "hook": "fast",
    "exposition": "fast",
    "evidence": "normal",
    "climax": "fast",
    "reflection": "normal",
    "transition_density": 0.55
  },
  "transitions": {
    "default": "cut",
    "preferred": [
      "cut",
      "flash",
      "dissolve",
      "soft"
    ],
    "avoid": []
  },
  "audio": {
    "ambience_intensity": 0.38,
    "sfx_intensity": 0.74,
    "music_intensity": 0.58,
    "music_duck_db": -9
  },
  "hook": {
    "window_seconds": 22,
    "attention_target": 0.9,
    "prefer_visual_change": true
  },
  "assets": {
    "preferred": [
      "image",
      "video",
      "stock_video",
      "stock_image"
    ],
    "avoid_repetition": true
  },
  "captions": {
    "style": "kinetic",
    "density": "high",
    "emphasis": "strong"
  },
  "ai_visual_prompt": {
    "style": "explanatory visuals, diagrams, conceptual metaphors, process illustrations, before/after comparisons for narrated explainers",
    "realism": 0.62,
    "composition": "center-weighted subject, bold readable silhouettes, concept clarity over pretty empty frames",
    "avoid": [
      "static empty rooms",
      "blurry b-roll",
      "busy crowds without focus",
      "decoration without explanation"
    ]
  },
  "intelligence": {
    "weights": {
      "explainer_density": 0.3,
      "narration_led": 0.18,
      "hook_intensity": 0.18,
      "visualization_need": 0.16,
      "abstract_concept_density": 0.1,
      "educational_density": 0.08
    },
    "preview_visual": "Explanatory • Metaphor • Process",
    "preview_camera": "Active • Purposeful",
    "preview_pacing": "Beat-driven turnover",
    "preview_audio": "Purposeful SFX • Controlled ambience",
    "variety_family": "explainer",
    "influences": [
      "visual_explains_narration",
      "hook_attention_weighting",
      "beat_driven_turnover",
      "stronger_purposeful_sfx"
    ]
  },
  "visual_roles": {
    "weights": {
      "process": 0.9,
      "comparison": 0.85,
      "object": 0.8,
      "mechanism": 0.75,
      "data": 0.7,
      "abstract": 0.65,
      "establishing": 0.5
    },
    "avoid": [
      "archival_evidence"
    ]
  },
  "source_preferences": {
    "ranked": [
      "pexels",
      "pixabay",
      "flow",
      "youtube",
      "openverse"
    ],
    "avoid": []
  },
  "search_guidance": {
    "prefer_terms": [
      "diagram",
      "demonstration",
      "comparison",
      "process",
      "explainer",
      "object close-up"
    ],
    "avoid_terms": [
      "archival",
      "historical document",
      "slow broll only"
    ],
    "evidence_bias": "low",
    "query_expansion": true
  },
  "selection_rules": {
    "prefer_evidence_when_factual": false,
    "avoid_generic_when_specific": true,
    "repetition_penalty": 0.3,
    "provider_repetition_penalty": 0.2,
    "concept_repetition_penalty": 0.35
  },
  "storytelling": {
    "narrative": "Fast coherent explanatory visuals with strong early hook",
    "hook_strategy": "Visual surprise in first 8 seconds",
    "evidence_priority": "low"
  },
  "shot_selection": {
    "establishing_weight": 0.35,
    "evidence_weight": 0.3,
    "atmosphere_weight": 0.25,
    "process_weight": 0.9
  }
}
