    "concept_repetition_penalty": 0.4
  },
  "storytelling": {
    "narrative": "Clear teaching visuals — diagrams, demos, and step-by-step process.",
    "hook_strategy": "Lead with the most specific visual evidence available",
    "evidence_priority": "medium"
  },
  "shot_selection": {
    "establishing_weight": 0.5,
    "evidence_weight": 0.4,
    "atmosphere_weight": 0.45,
    "process_weight": 0.5
