{
  "id": "history_documentary",
  "version": 3,
  "name": "History Documentary",
  "identity": {
    "description": "Archival, evidence-driven historical storytelling with restrained motion and chronological clarity.",
    "tone": "authoritative, measured, archival",
    "best_for": [
      "history",
      "archaeology",
      "biographies",
      "wars",
      "ancient civilizations"
    ]
  },
  "visual": {
    "treatment": "archival documentary",
    "camera": {
      "preferred": [
        "static",
        "hold",
        "subtle_drift",
        "push_in"
      ],
      "intensity": 0.28
    },
    "motion_rules": {
      "prefer_still_plates": true,
      "max_push_ratio": 0.2,
      "dramatic_push_on_evidence": true
    },
    "variety": {
      "prefer_documents_maps": true,
      "min_unique_keys": 0.55,
      "avoid_repeated_archival_photo": true
    }
  },
  "pacing": {
    "default": "slow",
    "hook": "normal",
    "exposition": "slow",
    "evidence": "normal",
    "climax": "fast",
    "reflection": "slow",
    "transition_density": 0.18
  },
  "transitions": {
    "default": "cut",
    "preferred": [
      "cut",
      "dissolve",
      "fade"
    ],
    "avoid": [
      "flash"
    ]
  },
  "audio": {
    "ambience_intensity": 0.58,
    "sfx_intensity": 0.28,
    "music_intensity": 0.4,
    "music_duck_db": -12
  },
  "hook": {
    "window_seconds": 28,
    "attention_target": 0.68,
    "prefer_visual_change": true
  },
  "assets": {
    "preferred": [
      "stock_image",
      "stock_video",
      "youtube_video",
      "image"
    ],
    "avoid_repetition": true
  },
  "captions": {
    "style": "documentary",
    "density": "low",
    "emphasis": "subtle"
  },
  "ai_visual_prompt": {
    "style": "period-accurate historical documentary stills, archival texture, maps, documents, artifacts, historically accurate recreations",
    "realism": 0.9,
    "composition": "evidence-forward framing; emphasize dates, places, people; documentary depth of field",
    "avoid": [
      "modern smartphones",
      "neon cyberpunk",
      "anachronistic fashion",
      "anachronistic architecture",
      "CGI fantasy",
      "modern cars in period scenes"
    ]
  },
  "intelligence": {
    "weights": {
      "historical_density": 0.35,
      "evidence_density": 0.25,
      "archival_visual_need": 0.2,
      "chronology_density": 0.12,
      "educational_density": 0.05,
      "cinematic_potential": 0.03
    },
    "preview_visual": "Archival • Evidence • Maps",
    "preview_camera": "Measured • Subtle",
    "preview_pacing": "Measured → Dramatic reveals",
    "preview_audio": "Atmospheric • Restrained",
    "variety_family": "archival",
    "influences": [
      "archival_visual_preference",
      "measured_pacing",
      "evidence_scene_priority",
      "chronological_clarity",
      "restrained_camera"
    ]
  },
  "visual_roles": {
    "weights": {
      "archival_evidence": 0.95,
      "document": 0.9,
      "event": 0.85,
      "map": 0.8,
      "timeline": 0.75,
      "character": 0.7,
      "location": 0.65,
      "atmosphere": 0.35
    },
    "avoid": [
      "abstract",
      "generic stock"
    ]
  },
  "source_preferences": {
    "ranked": [
      "archive",
      "youtube",
      "openverse",
      "pexels",
      "pixabay"
    ],
    "avoid": []
  },
  "search_guidance": {
    "prefer_terms": [
      "archival footage",
      "historical photograph",
      "period document",
      "newspaper",
      "map",
      "timeline"
    ],
    "avoid_terms": [
      "modern office",
      "generic businessman",
      "smartphone",
      "neon"
    ],
    "evidence_bias": "high",
    "query_expansion": true
  },
  "selection_rules": {
    "prefer_evidence_when_factual": true,
    "avoid_generic_when_specific": true,
    "repetition_penalty": 0.4,
    "provider_repetition_penalty": 0.2,
    "concept_repetition_penalty": 0.45
  },
  "storytelling": {
    "narrative": "Evidence-led chronology with archival authenticity",
    "hook_strategy": "Open with a specific historical image or document",
    "evidence_priority": "high"
  },
  "shot_selection": {
    "establishing_weight": 0.55,
    "evidence_weight": 0.9,
    "atmosphere_weight": 0.25,
    "process_weight": 0.3
  }
}
